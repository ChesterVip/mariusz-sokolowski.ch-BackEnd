
# --- MAILJET (for Render deployment or local testing with USE_MAILJET=true) ---
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
# Prawdziwy adres nadawcy (musi być zautoryzowany w Mailjet)
MAILJET_FROM_EMAIL=info@mariusz-sokolowski.ch
# Nazwa wyświetlana w mailu
MAILJET_FROM_NAME=Mariusz Sokołowski
# Reply-To będzie automatycznie ustawiony na info@mariusz-sokolowski.ch
USE_MAILJET=false # Set to true to force Mailjet locally, otherwise uses SMTP

# --- OAUTH 2.0 CONFIGURATION ---
# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# ===================================================
# AUTH0 - POLECANE! (Zarządza wszystkimi providerami)
# ===================================================
# Auth0 Universal Login - obsługuje Google, Facebook, Apple i więcej w jednym miejscu
AUTH0_DOMAIN=dev-wc13h60gy2uuna8y.us.auth0.com
AUTH0_AUDIENCE=https://mariusz-sokolowski-ch-backend.onrender.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_CALLBACK_URL=http://localhost:3001/auth/auth0/callback

# ===================================================
# OPCJONALNE: Bezpośrednie OAuth (jeśli nie używasz Auth0)
# ===================================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Apple OAuth (Sign in with Apple)
APPLE_CLIENT_ID=your_apple_service_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=./certs/AuthKey_XXXXX.p8
APPLE_CALLBACK_URL=http://localhost:3001/auth/apple/callback

